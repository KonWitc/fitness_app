// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// User model for authentication (future feature)
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workouts  Workout[]
  goals     Goal[]
}

// Exercise library
model Exercise {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String   // e.g., "strength", "cardio", "flexibility"
  muscleGroup String?  // e.g., "chest", "back", "legs"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workoutExercises WorkoutExercise[]
}

// Workout session
model Workout {
  id        String   @id @default(uuid())
  name      String?
  date      DateTime @default(now())
  notes     String?
  duration  Int?     // in minutes
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?     @relation(fields: [userId], references: [id])
  exercises WorkoutExercise[]
}

// Junction table for exercises in a workout
model WorkoutExercise {
  id         String   @id @default(uuid())
  workoutId  String
  exerciseId String
  sets       Int?
  reps       Int?
  weight     Float?   // in kg or lbs
  duration   Int?     // in seconds (for cardio/timed exercises)
  notes      String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  workout  Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  @@index([workoutId])
  @@index([exerciseId])
}

// Goals tracking
model Goal {
  id          String   @id @default(uuid())
  title       String
  description String?
  targetValue Float?
  currentValue Float?
  unit        String?  // e.g., "kg", "reps", "minutes"
  deadline    DateTime?
  completed   Boolean  @default(false)
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])
}
