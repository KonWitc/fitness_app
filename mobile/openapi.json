  "info": {
    "title": "Fitness API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "alex@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "nullable": true,
            "example": "Alex"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UserEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "email",
          "name"
        ]
      },
      "AuthSessionEntity": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT for `Authorization: Bearer`, short-lived"
          },
          "refreshToken": {
            "type": "string",
            "description": "Opaque and single use: exchange at /api/auth/token/refresh"
          },
          "expiresIn": {
            "type": "integer",
            "description": "Seconds until the access token expires"
          },
          "user": {
            "$ref": "#/components/schemas/UserEntity"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "expiresIn",
          "user"
        ]
      },
      "SignInDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "demo@fitness.local"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "TokenPairEntity": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT for `Authorization: Bearer`, short-lived"
          },
          "refreshToken": {
            "type": "string",
            "description": "Opaque and single use: exchange at /api/auth/token/refresh"
          },
          "expiresIn": {
            "type": "integer",
            "description": "Seconds until the access token expires"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "expiresIn"
        ]
      },
      "ExerciseEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "category": {
            "type": "string"
          },
          "muscleGroup": {
            "type": "string",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "videoUrl": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "category",
          "muscleGroup",
          "imageUrl",
          "videoUrl",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateExerciseDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Bench Press"
          },
          "category": {
            "type": "string",
            "example": "strength",
            "description": "Stored lowercase"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "muscleGroup": {
            "type": "string",
            "nullable": true,
            "example": "chest",
            "description": "Stored lowercase"
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "videoUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "name",
          "category"
        ]
      },
      "UpdateExerciseDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "muscleGroup": {
            "type": "string",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "videoUrl": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "WorkoutExerciseEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "workoutId": {
            "type": "string",
            "format": "uuid"
          },
          "exerciseId": {
            "type": "string",
            "format": "uuid"
          },
          "exercise": {
            "$ref": "#/components/schemas/ExerciseEntity"
          },
          "sets": {
            "type": "integer",
            "nullable": true
          },
          "reps": {
            "type": "integer",
            "nullable": true
          },
          "weight": {
            "type": "number",
            "nullable": true,
            "description": "kg"
          },
          "duration": {
            "type": "integer",
            "nullable": true,
            "description": "seconds"
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "order": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "workoutId",
          "exerciseId",
          "exercise",
          "sets",
          "reps",
          "weight",
          "duration",
          "notes",
          "order",
          "createdAt"
        ]
      },
      "WorkoutEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "duration": {
            "type": "integer",
            "nullable": true,
            "description": "minutes"
          },
          "userId": {
            "type": "string"
          },
          "exercises": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkoutExerciseEntity"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "date",
          "notes",
          "duration",
          "userId",
          "exercises",
          "createdAt",
          "updatedAt"
        ]
      }
    }
  }
}
