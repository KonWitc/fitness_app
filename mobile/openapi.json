        "operationId": "findAll",
        "parameters": [
          {
            "name": "dateFrom",
            "required": false,
            "in": "query",
            "schema": {
              "format": "date-time",
              "example": "2026-01-01",
              "type": "string"
            }
          },
          {
            "name": "dateTo",
            "required": false,
            "in": "query",
            "schema": {
              "format": "date-time",
              "example": "2026-12-31",
              "type": "string"
            }
