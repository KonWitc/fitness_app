// Prisma 7: the connection URL lives in prisma.config.ts, and the client is
// generated as ESM into src/generated/prisma (gitignored, run `npx prisma generate`).
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique // stored trimmed + lowercase
  name         String?
  passwordHash String // scrypt, from @nestjs/authentication's PasswordHasher
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workouts Workout[]
  goals    Goal[]
}

// Refresh tokens for the mobile app (RefreshTokenStore of @nestjs/authentication).
// No foreign key to User on purpose: the store contract is user-agnostic, and
// tokens of a deleted user are rejected anyway (JwtAuth finds no user).
model RefreshToken {
  id              String    @id // SHA-256 of the token, never the token itself
  familyId        String
  userId          String
  createdAt       DateTime
  expiresAt       DateTime
  familyExpiresAt DateTime
  usedAt          DateTime?
  claims          Json?

  @@index([familyId])
  @@index([userId])
  @@index([familyExpiresAt])
}

// A revoked family stays revoked, including for tokens saved after the revocation.
model RevokedRefreshTokenFamily {
  familyId  String    @id
  revokedAt DateTime  @default(now())
  expiresAt DateTime? // the family's absolute expiry, after which the row can go

  @@index([expiresAt])
}

// Exercise library
model Exercise {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String // e.g., "strength", "cardio", "flexibility"
  muscleGroup String? // e.g., "chest", "back", "legs"
  imageUrl    String? // URL to an image showing the exercise
  videoUrl    String? // URL to a video (e.g. YouTube) showing the exercise
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workoutExercises WorkoutExercise[]

  @@index([category, muscleGroup])
}

// Workout session
model Workout {
  id        String   @id @default(uuid())
  name      String?
  date      DateTime @default(now())
  notes     String?
  duration  Int? // in minutes
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]

  @@index([userId, date])
}

// Junction table for exercises in a workout
model WorkoutExercise {
  id         String   @id @default(uuid())
  workoutId  String
  exerciseId String
  sets       Int?
  reps       Int?
  weight     Float? // in kg
  duration   Int? // in seconds (for cardio/timed exercises)
  notes      String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  workout  Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  @@index([workoutId])
  @@index([exerciseId])
}

// Goals tracking
model Goal {
  id           String    @id @default(uuid())
  title        String
  description  String?
  targetValue  Float?
  currentValue Float?
  unit         String? // e.g., "kg", "reps", "minutes"
  deadline     DateTime?
  completed    Boolean   @default(false)
  userId       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}
